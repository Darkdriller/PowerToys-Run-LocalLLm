<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<RootNamespace>Community.PowerToys.Run.Plugin.LocalLLm</RootNamespace>
	<AssemblyName>Community.PowerToys.Run.Plugin.LocalLLM</AssemblyName>
	<Version>1.0.2</Version>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PowerToysLibRoot>..\lib\$(Platform)</PowerToysLibRoot>
  </PropertyGroup>

  <Target Name="ValidatePowerToysDependencies" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(PowerToysLibRoot)')"
      Text="PowerToys dependency folder not found for platform '$(Platform)': $(PowerToysLibRoot). Add required DLLs before building." />
  </Target>

  <ItemGroup>
    <Reference Include="PowerToys.Common.UI">
      <HintPath>$(PowerToysLibRoot)\PowerToys.Common.UI.dll</HintPath>
    </Reference>
    <Reference Include="PowerToys.ManagedCommon">
      <HintPath>$(PowerToysLibRoot)\PowerToys.ManagedCommon.dll</HintPath>
    </Reference>
    <Reference Include="PowerToys.Settings.UI.Lib">
      <HintPath>$(PowerToysLibRoot)\PowerToys.Settings.UI.Lib.dll</HintPath>
    </Reference>
    <Reference Include="Wox.Infrastructure">
      <HintPath>$(PowerToysLibRoot)\Wox.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="Wox.Plugin">
      <HintPath>$(PowerToysLibRoot)\Wox.Plugin.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory> PreserveNewest </CopyToOutputDirectory>
    </None>
    <None Include="Images\*.png">
      <CopyToOutputDirectory> PreserveNewest </CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
  </ItemGroup>
<PropertyGroup>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
</PropertyGroup>
</Project>
